# ─────────────────────────────────────────────────────────────
# Sky Blue Creators Agency — variables de entorno
# Copiá este archivo a `.env` y completá los valores.
# ─────────────────────────────────────────────────────────────

# Base de datos.
# Desarrollo local (por defecto): SQLite.
DATABASE_URL="file:./dev.db"
# Producción (Vercel/Neon/Supabase): descomentá y usá Postgres,
# y cambiá el provider en prisma/schema.prisma a "postgresql".
# DATABASE_URL="postgresql://user:pass@host:5432/skyblue?sslmode=require"

# Secreto para firmar los JWT de sesión (obligatorio).
# Generá uno con: openssl rand -base64 32
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# URL pública de la app (para links del formulario, etc.).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Orígenes permitidos para la extensión Halcón (CORS), separados por coma.
# En producción reemplazá <ID> por el ID real de la extensión publicada.
EXTENSION_ORIGINS="chrome-extension://*"

# Credenciales del usuario master (Matías) que crea el seed.
SEED_MASTER_EMAIL="matias@skyblue.agency"
SEED_MASTER_PASSWORD="Cambiar123!"
